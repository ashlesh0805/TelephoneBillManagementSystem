<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.telecom.controller.BillController">
   <children>
      <!-- Top Action & Filter Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <TextField fx:id="searchField" prefWidth="280.0" promptText="🔍  Search by bill #, customer name, phone..." styleClass="search-box" />

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Payment Status:" style="-fx-text-fill: #64748b; -fx-font-weight: 600;" />
                  <ComboBox fx:id="statusFilterCombo" prefWidth="130.0" />
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#loadBills" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button onAction="#handleExportCsv" styleClass="btn-secondary" text="📊 Export CSV" />
            <Button onAction="#handleGenerateBill" styleClass="btn-primary" text="+ Generate Monthly Bill" />
         </children>
      </HBox>

      <!-- Bills Table Card -->
      <VBox VBox.vgrow="ALWAYS" styleClass="card-panel">
         <children>
            <TableView fx:id="billTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colBillNo" prefWidth="130.0" text="Invoice #" />
                  <TableColumn fx:id="colCustomer" prefWidth="160.0" text="Customer Name" />
                  <TableColumn fx:id="colPeriod" prefWidth="90.0" text="Period" />
                  <TableColumn fx:id="colRental" prefWidth="100.0" text="Rental (₹)" />
                  <TableColumn fx:id="colCalls" prefWidth="100.0" text="Calls (₹)" />
                  <TableColumn fx:id="colTax" prefWidth="90.0" text="GST 18% (₹)" />
                  <TableColumn fx:id="colTotal" prefWidth="110.0" text="Payable (₹)" />
                  <TableColumn fx:id="colDueDate" prefWidth="110.0" text="Due Date" />
                  <TableColumn fx:id="colStatus" prefWidth="95.0" text="Status" />
                  <TableColumn fx:id="colActions" prefWidth="180.0" text="Actions" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
