<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.telecom.controller.TariffPlanController">
   <children>
      <!-- Top Action Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#loadPlans" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button fx:id="addPlanButton" onAction="#handleAddPlan" styleClass="btn-primary" text="+ Create New Plan" />
         </children>
      </HBox>

      <!-- Plans Table Card -->
      <VBox VBox.vgrow="ALWAYS" styleClass="card-panel">
         <children>
            <TableView fx:id="planTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colName" prefWidth="180.0" text="Package / Plan Name" />
                  <TableColumn fx:id="colRental" prefWidth="120.0" text="Monthly Rental" />
                  <TableColumn fx:id="colFreeMins" prefWidth="110.0" text="Free Minutes" />
                  <TableColumn fx:id="colLocal" prefWidth="110.0" text="Local Rate" />
                  <TableColumn fx:id="colStd" prefWidth="110.0" text="STD Rate" />
                  <TableColumn fx:id="colIsd" prefWidth="110.0" text="ISD Rate" />
                  <TableColumn fx:id="colSubscribers" prefWidth="110.0" text="Subscribers" />
                  <TableColumn fx:id="colActions" prefWidth="140.0" text="Actions" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
