<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.telecom.controller.CallRecordController">
   <children>
      <!-- Top Action & Filter Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Subscriber:" style="-fx-text-fill: #64748b; -fx-font-weight: 600;" />
                  <ComboBox fx:id="customerFilterCombo" prefWidth="200.0" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Call Type:" style="-fx-text-fill: #64748b; -fx-font-weight: 600;" />
                  <ComboBox fx:id="callTypeFilterCombo" prefWidth="120.0" />
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#loadCalls" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button onAction="#handleBulkImportCsv" styleClass="btn-secondary" text="📁 Bulk Import CSV" />
            <Button onAction="#handleLogCall" styleClass="btn-primary" text="+ Log Single Call" />
         </children>
      </HBox>

      <!-- CDR Table Card -->
      <VBox VBox.vgrow="ALWAYS" styleClass="card-panel">
         <children>
            <TableView fx:id="callTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="CDR #" />
                  <TableColumn fx:id="colTimestamp" prefWidth="180.0" text="Date &amp; Time" />
                  <TableColumn fx:id="colCustomer" prefWidth="180.0" text="Calling Subscriber" />
                  <TableColumn fx:id="colDestination" prefWidth="160.0" text="Dialed Number" />
                  <TableColumn fx:id="colType" prefWidth="140.0" text="Category" />
                  <TableColumn fx:id="colDuration" prefWidth="110.0" text="Duration" />
                  <TableColumn fx:id="colCost" prefWidth="120.0" text="Tariff Cost" />
                  <TableColumn fx:id="colActions" prefWidth="90.0" text="Action" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
