<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.telecom.controller.CustomerController">
   <children>
      <!-- Top Action Bar -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <TextField fx:id="searchField" prefWidth="280.0" promptText="🔍  Search by name, phone or email..." styleClass="search-box" />
            
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Status:" style="-fx-text-fill: #64748b; -fx-font-weight: 600;" />
                  <ComboBox fx:id="statusFilterCombo" prefWidth="130.0" />
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#loadCustomers" styleClass="btn-secondary" text="🔄 Refresh" />
            <Button onAction="#handleAddCustomer" styleClass="btn-primary" text="+ Register Subscriber" />
         </children>
      </HBox>

      <!-- Customers Table Card -->
      <VBox VBox.vgrow="ALWAYS" styleClass="card-panel">
         <children>
            <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="colName" prefWidth="170.0" text="Customer Name" />
                  <TableColumn fx:id="colPhone" prefWidth="130.0" text="Phone Number" />
                  <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                  <TableColumn fx:id="colAddress" prefWidth="220.0" text="Address" />
                  <TableColumn fx:id="colPlan" prefWidth="150.0" text="Subscribed Plan" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colActions" prefWidth="140.0" text="Actions" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
