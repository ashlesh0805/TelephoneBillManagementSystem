<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootBorderPane" prefHeight="760.0" prefWidth="1200.0" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.telecom.controller.MainLayoutController">
   <!-- Left Sidebar -->
   <left>
      <VBox prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <!-- Brand -->
            <VBox styleClass="sidebar-brand">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="⚡" style="-fx-font-size: 20px; -fx-text-fill: #38bdf8;" />
                        <Label text="APEX TELCO" styleClass="sidebar-title" />
                     </children>
                  </HBox>
                  <Label text="Billing &amp; Revenue Suite" styleClass="sidebar-subtitle" />
               </children>
            </VBox>

            <!-- Navigation Links -->
            <VBox spacing="4.0">
               <children>
                  <Button fx:id="navDashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-btn" text="📊   Dashboard" />
                  <Button fx:id="navCustomers" maxWidth="Infinity" onAction="#showCustomers" styleClass="nav-btn" text="👥   Customers" />
                  <Button fx:id="navCalls" maxWidth="Infinity" onAction="#showCallRecords" styleClass="nav-btn" text="📞   Call Records (CDR)" />
                  <Button fx:id="navBills" maxWidth="Infinity" onAction="#showBills" styleClass="nav-btn" text="📄   Bills &amp; Invoices" />
                  <Button fx:id="navPlans" maxWidth="Infinity" onAction="#showTariffPlans" styleClass="nav-btn" text="🏷️   Tariff Plans" />
                  <Button fx:id="navReports" maxWidth="Infinity" onAction="#showReports" styleClass="nav-btn" text="📈   Reports &amp; Analytics" />
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- User Info Card & Actions -->
            <VBox spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 12px; -fx-background-radius: 10px; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 10px;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="userNameLabel" text="Administrator" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" />
                           </children>
                        </VBox>
                        <Label fx:id="userRoleBadge" text="ADMIN" />
                     </children>
                  </HBox>

                  <Separator opacity="0.15" />

                  <HBox spacing="8.0">
                     <children>
                        <Button fx:id="themeToggleButton" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleToggleTheme" styleClass="btn-secondary, btn-sm" text="🌙 Dark Mode" />
                        <Button onAction="#handleLogout" style="-fx-background-color: rgba(239, 68, 68, 0.2); -fx-text-fill: #fca5a5; -fx-cursor: hand; -fx-background-radius: 6px; -fx-font-size: 11.5px; -fx-font-weight: bold;" text="🚪 Exit" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <!-- Center Area: Top Header + Dynamic Content -->
   <center>
      <BorderPane BorderPane.alignment="CENTER">
         <top>
            <HBox alignment="CENTER_LEFT" styleClass="top-bar" style="-fx-padding: 18px 32px;" BorderPane.alignment="CENTER">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label fx:id="pageTitleLabel" styleClass="panel-title" text="Operational Dashboard" />
                        <Label fx:id="pageSubtitleLabel" styleClass="panel-subtitle" text="Real-time metrics, revenue performance, and key indicators" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Label fx:id="currentDateLabel" style="-fx-text-fill: #64748b; -fx-font-weight: 500; -fx-font-size: 12.5px;" text="Wednesday, 01 January 2026" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </top>
         <center>
            <StackPane fx:id="contentHolder" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER" />
         </center>
      </BorderPane>
   </center>
</BorderPane>
